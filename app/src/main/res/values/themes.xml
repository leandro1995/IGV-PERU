<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme with no action bar -->
    <style name="Theme.IGVPERU" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen theme configuration conforming to Core Splash Screen API -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">@color/splash_screen_background</item>
        <!-- Icon displayed during splash screen -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <!-- Duration of splash screen animation/timeout -->
        <item name="windowSplashScreenAnimationDuration">@integer/splash_screen_time_out</item>
        <!-- Theme to apply after splash screen dismisses -->
        <item name="postSplashScreenTheme">@style/Theme.IGVPERU</item>
    </style>
</resources>