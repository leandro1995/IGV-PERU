<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema base de la aplicación sin barra de acción -->
    <style name="Theme.IGVPERU" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Configuración del tema para la pantalla de bienvenida (Splash Screen) conforme a la API Core SplashScreen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Color de fondo de la pantalla de bienvenida -->
        <item name="windowSplashScreenBackground">@color/splash_screen_background</item>
        <!-- Ícono mostrado durante la pantalla de bienvenida -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <!-- Duración de la animación o tiempo de espera de la pantalla de bienvenida -->
        <item name="windowSplashScreenAnimationDuration">@integer/splash_screen_time_out</item>
        <!-- Tema a aplicar después de ocultar la pantalla de bienvenida -->
        <item name="postSplashScreenTheme">@style/Theme.IGVPERU</item>
    </style>
</resources>